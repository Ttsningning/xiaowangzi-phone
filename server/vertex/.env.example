# Keep the real environment file outside the repository, e.g. /etc/xiaowangzi/vertex.env
# Optional migration from an existing file; omit for first setup in the phone.
# GOOGLE_APPLICATION_CREDENTIALS=/etc/xiaowangzi/service-account.json
VERTEX_CONFIG_FILE=/var/lib/xiaowangzi/vertex-config.json
# Optional override; otherwise use project_id from the service account file.
# GOOGLE_CLOUD_PROJECT=your-project-id
VERTEX_LOCATION=global
# Exact model IDs available to your project/region, comma separated. Required.
VERTEX_MODELS=
# Generate once with: openssl rand -hex 32
BRIDGE_TOKEN=
# Generate another DIFFERENT value for configuration changes.
VERTEX_ADMIN_TOKEN=
ALLOWED_ORIGINS=https://xiaowangzi-phone.gtt137233896.chatgpt.site
BRIDGE_HOST=127.0.0.1
PORT=8787
